# =============================================================================
# SYSTEM-INFRAS SECRETS
# =============================================================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control
#
# Run ./init.sh to generate secure values automatically

# =============================================================================
# CADDY CONFIGURATION
# =============================================================================
# Admin email for Let's Encrypt certificate notifications
ADMIN_EMAIL=admin@example.com

# Generate bcrypt hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext "your-password"
#
# Username: admin
# Default placeholder - MUST be changed before deployment
CADDY_BASIC_AUTH_HASH=$2a$14$CHANGE_THIS_HASH_IMMEDIATELY

# =============================================================================
# SEQ CONFIGURATION (optional)
# =============================================================================
# API key for remote log ingestion (leave empty if not needed)
SEQ_API_KEY=

# Password for Seq admin user (minimum 8 characters)
SEQ_ADMIN_PASSWORD=

# Log retention days in Seq (default: 15)
SEQ_RETENTION_DAYS=15
